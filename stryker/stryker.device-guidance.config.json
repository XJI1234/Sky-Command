{
  "$schema": "../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "mutate": ["src/modules/device-console/device-guidance/index.ts"],
  "testFiles": ["tests/device-guidance-contract.test.ts", "tests/device-guidance-architecture.test.ts"],
  "reporters": ["clear-text", "progress", "json"],
  "coverageAnalysis": "off",
  "mutator": { "excludedMutations": ["StringLiteral"] },
  "concurrency": 4,
  "thresholds": { "high": 100, "low": 100, "break": 100 },
  "jsonReporter": { "fileName": "reports/mutation/device-guidance.json" }
}
