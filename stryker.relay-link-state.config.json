{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "checkers": ["typescript"],
  "tsconfigFile": "tsconfig.type-tests.json",
  "mutate": [
    "src/modules/relay-link/command-tracker/index.ts",
    "src/modules/relay-link/device-registry/index.ts"
  ],
  "testFiles": [
    "tests/command-tracker-contract.test.ts",
    "tests/device-registry-contract.test.ts",
    "tests/relay-link-contract.test.ts"
  ],
  "reporters": ["clear-text", "progress", "json"],
  "jsonReporter": { "fileName": "reports/mutation/relay-link-state.json" },
  "coverageAnalysis": "perTest",
  "vitest": {
    "configFile": "vitest.mutation.config.ts",
    "related": false
  },
  "concurrency": 8,
  "thresholds": {
    "high": 100,
    "low": 100,
    "break": 100
  }
}
