{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "mutate": ["src/modules/route-planning/obstacle-analysis/index.ts"],
  "testFiles": ["tests/obstacle-analysis-contract.test.ts"],
  "reporters": ["clear-text", "progress", "json"],
  "coverageAnalysis": "off",
  "mutator": { "excludedMutations": ["StringLiteral"] },
  "concurrency": 4,
  "thresholds": { "high": 100, "low": 100, "break": 100 },
  "jsonReporter": { "fileName": "reports/mutation/obstacle-analysis.json" }
}
