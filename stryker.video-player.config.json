{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "mutate": ["src/modules/media-pipeline/video-player/index.ts"],
  "testFiles": ["tests/video-player-contract.test.ts", "tests/video-player-architecture.test.ts"],
  "reporters": ["clear-text", "progress", "json"],
  "coverageAnalysis": "off",
  "vitest": { "related": false },
  "mutator": { "excludedMutations": ["StringLiteral"] },
  "concurrency": 4,
  "thresholds": { "high": 100, "low": 100, "break": 100 },
  "jsonReporter": { "fileName": "reports/mutation/video-player.json" }
}
