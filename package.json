{
  "name": "sky-command",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "productName": "Sky Command",
  "overrides": {
    "qs": "6.15.3"
  },
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:performance": "vitest run --config vitest.performance.config.ts",
    "test:cross-runtime-scenarios": "vitest run tests/cross-runtime-e2e-contract.test.ts tests/cross-runtime-workflow-model.test.ts tests/cross-runtime-protocol-verification.test.ts tests/cross-runtime-source-inventory.test.ts tests/cross-runtime-mission-ordering.test.ts tests/cross-runtime-resource-recovery.test.ts --reporter=default --reporter=./src/modules/cross-runtime-e2e/vitest-reporter.ts",
    "test:cross-runtime-e2e": "node scripts/run-cross-runtime-e2e.mjs",
    "test:types": "tsc --noEmit -p tsconfig.type-tests.json",
    "test:mutation": "stryker run",
    "build": "node scripts/build-desktop.mjs",
    "desktop": "electron electron/main.mjs",
    "start:desktop": "npm run build && npm run desktop",
    "check": "npm run test:types && npm run test:coverage && npm run test:performance",
    "verify": "npm run test:cross-runtime-e2e"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^9.3.0",
    "@stryker-mutator/typescript-checker": "^9.3.0",
    "@stryker-mutator/vitest-runner": "^9.3.0",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "electron": "^37.2.6",
    "esbuild": "^0.25.12",
    "fast-check": "^4.2.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@noble/hashes": "^1.8.0",
    "@types/ws": "^8.5.14",
    "@zip.js/zip.js": "^2.8.36",
    "cesium": "^1.143.0",
    "hls.js": "^1.7.0",
    "node-media-server": "^2.6.6",
    "saxes": "^6.0.0",
    "ws": "^8.18.3"
  }
}
