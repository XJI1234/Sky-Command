{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "mutate": ["src/modules/geo-map/city-model/index.ts"],
  "testFiles": ["tests/city-model-contract.test.ts"],
  "reporters": ["clear-text", "progress", "json"],
