{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "mutate": [
    "src/modules/cross-runtime-e2e/workflow-model.ts",
    "src/modules/cross-runtime-e2e/verification-evidence.ts"
  ],
  "reporters": ["clear-text", "progress", "json"],
  "jsonReporter": {
    "fileName": "reports/mutation/cross-runtime-verification.json"
  },
  "coverageAnalysis": "perTest",
  "concurrency": 4,
  "thresholds": {
    "high": 100,
    "low": 100,
    "break": 100
  },
  "vitest": {
    "related": true
  }
}
