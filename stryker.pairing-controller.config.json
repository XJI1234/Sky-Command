{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "mutate": ["src/modules/device-console/pairing-controller/index.ts"],
  "testFiles": ["tests/pairing-controller-contract.test.ts", "tests/device-console-foundations-architecture.test.ts"],
  "reporters": ["clear-text", "progress", "json"],
  "coverageAnalysis": "off",
  "mutator": { "excludedMutations": ["StringLiteral"] },
  "concurrency": 4,
  "thresholds": { "high": 100, "low": 100, "break": 100 },
  "jsonReporter": { "fileName": "reports/mutation/pairing-controller.json" }
}
